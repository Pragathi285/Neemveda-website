# Copy this file to .env and fill in your values. Never share or commit .env.

PORT=4173

# --- Razorpay (https://dashboard.razorpay.com -> Account & Settings -> API Keys)
# Use Test Mode keys (rzp_test_...) first; switch to Live keys when ready.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Webhooks -> add  https://YOUR-DOMAIN/api/payments/webhook
# with events: payment.captured, order.paid. Paste the webhook secret here.
RAZORPAY_WEBHOOK_SECRET=

# --- Email (Gmail: turn on 2-Step Verification, then create an App Password
# at https://myaccount.google.com/apppasswords and paste it as SMTP_PASS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=neemveda0@gmail.com
SMTP_PASS=
MAIL_FROM=neemveda <neemveda0@gmail.com>
# Where new-order and contact-form alerts are sent
OWNER_EMAIL=neemveda0@gmail.com

# --- Admin page at /admin (choose a long, unique password)
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- Optional
# Folder for orders, subscribers and messages (contains customer data: keep private, back it up)
DATA_DIR=data
# Set to 1 when running behind a proxy/load balancer (Render, Railway, Nginx) so rate limits see real IPs
TRUST_PROXY=0
